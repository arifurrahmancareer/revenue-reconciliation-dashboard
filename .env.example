# Environment variables template
# Copy to .env or .streamlit/secrets.toml for local configuration.
# NEVER commit real secret keys.

# Environment mode: "development" or "production"
ENVIRONMENT=development

# Database connection URL (Leave commented out for local SQLite ./recon.db)
# Point to a PostgreSQL instance for persistent cloud deployment:
# DATABASE_URL=postgresql://username:password@hostname:5432/dbname?sslmode=require

# Authentication & Session Security
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=dev-only-change-me
ALLOW_SIGNUP=true

# AI / LLM Configuration
# Leave blank to use the deterministic rules-based explanation fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=600
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
LLM_CACHE_ENABLED=true

# Upload limits (in bytes: 10485760 = 10 MB)
MAX_UPLOAD_BYTES=10485760
