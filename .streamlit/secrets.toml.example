# Copy to .streamlit/secrets.toml for local development.
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# secrets.toml is gitignored. NEVER commit the real file.
#
# On Streamlit Community Cloud you do not create this file at all: paste the same keys
# into Manage app -> Settings -> Secrets. Streamlit stores them encrypted and exposes them
# to the SERVER-SIDE process only, which is why the OpenAI key can live here safely and
# never reaches the browser.
#
# Every key below is optional. With an empty file the app still runs: SQLite for storage
# and deterministic explanations instead of model-written ones.

# ---------------------------------------------------------------- environment ------
ENVIRONMENT = "development"          # "production" on a live deployment

# ------------------------------------------------------------------- database ------
# Omit for local SQLite (./recon.db).
# On cloud deployments with ephemeral filesystems, every account and upload
# is wiped when the container restarts. Point this at a managed PostgreSQL provider for durable storage.
# A plain postgres:// or postgresql:// URL is rewritten to psycopg 3 automatically.
# DATABASE_URL = "postgresql://user:password@host/dbname?sslmode=require"

# ----------------------------------------------------------------------- auth ------
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET = "dev-only-change-me"
ALLOW_SIGNUP = true                  # set false to lock a public demo to the seeded user

# ------------------------------------------------------------------------ LLM ------
# Leave blank to run entirely without a model. Explanations then come from the
# deterministic fallback and the UI labels them as such.
OPENAI_API_KEY = ""
OPENAI_MODEL = "gpt-4o-mini"
LLM_TEMPERATURE = 0.2                # see README section 5 for why 0.2 and not 0.0 or 0.7
LLM_MAX_OUTPUT_TOKENS = 600
LLM_TIMEOUT_SECONDS = 20
LLM_MAX_RETRIES = 1
LLM_CACHE_ENABLED = true

# --------------------------------------------------------------------- uploads ------
MAX_UPLOAD_BYTES = 10485760          # 10 MB; keep in sync with server.maxUploadSize
